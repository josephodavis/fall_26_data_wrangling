import re
import numpy as np
import pandas as pd

raw = pd.read_csv('week01_customers.csv', dtype=str)

NULL_TOKENS = ["NaN", "unknown", "-"]

CITY_ALIASES = {
    "nyc": "New York",
    "new york city": "New York",
}

DATE_FORMATS = [
    "%Y-%m-%d",
    "%m/%d/%Y",
    "%b %d %Y",
]

EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$")





